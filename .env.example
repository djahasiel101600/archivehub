# ArchiveHub environment template.
# Copy to .env for local development:  cp .env.example .env
# With Docker Compose, these values are picked up from the shell/.env
# automatically (see docker-compose.yml variable interpolation).

# ------------------------------------------------------------------
# DATABASE PROVIDER SWITCH
# DB_PROVIDER selects which database the server connects to:
#   supabase -> uses SUPABASE_DATABASE_URL (SSL enabled automatically)
#   local    -> uses LOCAL_DATABASE_URL    (SSL disabled by default)
# With Docker Compose, the app container always runs in "local" mode
# against the bundled db service (set in docker-compose.yml).
# ------------------------------------------------------------------
DB_PROVIDER=supabase

# Supabase PostgreSQL (used when DB_PROVIDER=supabase):
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Local PostgreSQL (used when DB_PROVIDER=local), e.g. a local install
# or the docker compose database exposed on the host:
LOCAL_DATABASE_URL=postgresql://archivehub:archivehub_secret@localhost:5432/archivehub

# Fallback connection string, used when the active provider's variable
# above is not set. Docker Compose interpolates this for the db service.
DATABASE_URL=postgresql://archivehub:archivehub_secret@db:5432/archivehub

# SSL mode for the PostgreSQL connection: disable | require | prefer.
# Use "disable" for the bundled docker compose database; leave unset (or
# "require") for Supabase / remote hosts.
PGSSL=disable

# PostgreSQL credentials used by the docker compose db service.
POSTGRES_PASSWORD=archivehub_secret

# Secret used to sign auth/session tokens. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: Google Gemini API key for AI bundle suggestions.
GEMINI_API_KEY=
