# ArchiveHub environment template.
# Copy to .env for local development:  cp .env.example .env
# With Docker Compose, these values are picked up from the shell/.env
# automatically (see docker-compose.yml variable interpolation).

# PostgreSQL connection string.
# - Docker Compose bundled database (default, no change needed):
#   DATABASE_URL=postgresql://archivehub:archivehub_secret@db:5432/archivehub
# - Supabase (development) or any external PostgreSQL:
#   DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://archivehub:archivehub_secret@db:5432/archivehub

# SSL mode for the PostgreSQL connection: disable | require | prefer.
# Use "disable" for the bundled docker compose database; leave unset (or
# "require") for Supabase / remote hosts.
PGSSL=disable

# PostgreSQL credentials used by the docker compose db service.
POSTGRES_PASSWORD=archivehub_secret

# Secret used to sign auth/session tokens. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: Google Gemini API key for AI bundle suggestions.
GEMINI_API_KEY=
